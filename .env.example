# =============================================================================
# タビメモ（Tabimemo）環境変数
# このファイルを .env.local にコピーして、値を埋めてください。
#   cp .env.example .env.local
#
# 【重要】NEXT_PUBLIC_ で始まる変数だけがブラウザに渡されます。
#        それ以外（サービスロールキー、各種APIキー）は絶対にブラウザに出さないでください。
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase（必須）
# 無いとログイン・保存・共有ができません（画面は開きますが案内が出ます）。
#
# 取得方法:
#   1. https://supabase.com にサインアップし、New project を作成
#   2. 左メニュー Project Settings → Data API（または API）を開く
#   3. 「Project URL」を NEXT_PUBLIC_SUPABASE_URL に貼る
#   4. 公開用キーを NEXT_PUBLIC_SUPABASE_ANON_KEY に貼る
#      ・新しいUI: Project Settings → API Keys →「Publishable key」(sb_publishable_... )
#      ・古いUI  : 同じ画面の「Legacy API Keys」タブ →「anon public」(eyJhbGci... )
#      どちらでも動きます（anon は2026年末に廃止予定なので Publishable key 推奨）
#   ※ ダッシュボード上部の「Connect」ボタンから、URLとキーをまとめてコピーするのが最速です
# -----------------------------------------------------------------------------
# 形式の例: https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 形式の例: sb_publishable_xxxxx または eyJhbGciOi...（とても長い文字列）
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase の秘密キー（任意 / シード・リマインダー用）
# 次の2つで必要です:
#   ・npm run seed でサンプルデータを入れるとき
#   ・期間限定スポットのリマインダー通知（毎日の定期実行）を使うとき
#     → この場合だけ Vercel にも登録します（サーバー側だけで使われます）
# RLSを迂回できる強力なキーなので、ブラウザ側に渡る変数名（NEXT_PUBLIC_）には
# 絶対に入れないでください。
#
# 取得方法: Project Settings → API Keys
#   ・新しいUI: 「Secret keys」→ New secret key （sb_secret_... 作成時に1度だけ表示）
#   ・古いUI  : 「Legacy anon, service_role API keys」タブ →「service_role」の Reveal
#   どちらでも動きます（service_role は2026年末に廃止予定なので Secret key 推奨）
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# サイトURL（任意 / 推奨）
# 招待リンクや共有リンクの生成、OAuthのリダイレクト先に使います。
# ローカルでは未設定でも http://localhost:3000 が使われます。
# Vercelでは自動的に VERCEL_URL が使われますが、独自ドメインを使う場合は明示してください。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Google Places API (New)（任意）
# 未設定でも OpenStreetMap(Nominatim) で場所検索できます。
# 設定すると:
#   - 日本のお店の検索精度が上がる（チェーン店・新しい店に強い）
#   - お店の写真が自動で付く
#
# 取得方法:
#   1. https://console.cloud.google.com でプロジェクトを作成
#   2. 「Places API (New)」を有効化
#   3. 「APIとサービス」→「認証情報」→ APIキーを作成
#   4. キーの制限で Places API (New) のみに絞ることを推奨
#   ※ 従量課金です。無料枠を超えないよう予算アラートの設定をおすすめします。
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=


# -----------------------------------------------------------------------------
# Anthropic API（任意）
# 未設定でも「かんたん抽出（ルールベース）」でSNSテキストから店名を読み取ります。
# 設定すると、長いキャプションや崩れた日本語からの店名・エリア抽出が賢くなります。
#
# 取得方法:
#   1. https://console.anthropic.com でアカウント作成
#   2. API Keys → Create Key
#   ※ 従量課金です。1回の抽出はごく少量のトークンしか使いません。
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# プッシュ通知の鍵（任意）
# 「メンバーがスポットを追加したら、他のメンバーのスマホに通知を出す」機能に使います。
# 未設定でもアプリは普通に動きます（設定画面の通知スイッチが出なくなるだけ）。
#
# 作り方:
#   1. ターミナルで  npm run vapid  を実行
#   2. 表示された2行をこのファイル（.env.local）に貼る
#   3. Vercel の Project Settings → Environment Variables にも同じ値を登録
#   ※ 一度作った鍵は変えないでください。変えると全員の「通知ON」が無効になります。
#
# VAPID_SUBJECT は、プッシュサービス（Google/Appleなど）からの連絡先です。
# 自分のメールアドレスを mailto: 付きで入れてください。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com


# -----------------------------------------------------------------------------
# 定期実行の合言葉（任意 / リマインダー通知を使う場合は必須）
# 「期間限定スポットの開始・終了1週間前に通知する」処理を、毎日1回
# Vercel Cron が /api/cron/reminders を呼んで実行します。
# 外部から勝手に叩かれないよう、この合言葉で認証します。
#
# 作り方（ターミナルで実行し、出てきた文字列を貼る）:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# ※ この機能には SUPABASE_SERVICE_ROLE_KEY も必要です（cron時はログイン中の人が
#   いないため）。Vercel には「秘密」タイプで登録してください。
# -----------------------------------------------------------------------------
CRON_SECRET=


# -----------------------------------------------------------------------------
# Nominatim の User-Agent（任意 / 公開運用するなら実質必須）
# OpenStreetMapの利用規約で、連絡先を含むUser-Agentの送信が求められています。
# 公開して使う場合は、自分のアプリ名と連絡先メールに書き換えてください。
# 参考: https://operations.osmfoundation.org/policies/nominatim/
# -----------------------------------------------------------------------------
# 値に ( ) を含むので、シェルで読み込む場合に備えて引用符で囲む
NOMINATIM_USER_AGENT="Tabimemo/0.1 (contact: you@example.com)"
